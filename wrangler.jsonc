{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rustboy",
  "compatibility_date": "2026-09-06",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "rustboy.ai", "custom_domain": true },
    { "pattern": "www.rustboy.ai", "custom_domain": true }
  ]
}
