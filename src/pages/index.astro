---
import FaceMark from "../components/FaceMark.astro";
import HeroStill from "../components/HeroStill.astro";
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { BLOG, MEDIA, SITE } from "../config";
import { getPublishedPosts } from "../utils/posts";

const posts = (await getPublishedPosts()).slice(0, BLOG.postsOnHome);
---

<BaseLayout overlayHeader>
  <HeroStill src={MEDIA.heroStill} alt={MEDIA.heroStillAlt}>
    <div class="hero">
      <p class="hero__eyebrow">
        <FaceMark />
        {SITE.titleMark}
      </p>
      <h1 class="hero__title">{SITE.title}</h1>
      <p class="hero__cta">
        <a href="/blog/why-rustboy-ai/">Why Rustboy AI?</a>
      </p>
    </div>

    <p class="hero__rail tategaki" aria-hidden="true">ONE FACE</p>

    <p class="hero__notes" aria-hidden="true">
      <span class="hero__notes-mid">Warm green optic · empty socket</span>
      <span>The record</span>
    </p>
  </HeroStill>

  <section class="section wrap">
    <div class="latest__head">
      <h2 class="eyebrow">Latest</h2>
      <a class="latest__all label" href="/blog/">All notes →</a>
    </div>

    <div class="latest__list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <HeroStill variant="band" src={MEDIA.bandStill} alt={MEDIA.bandStillAlt}>
    <p class="band__label label">kf11j — rear lock</p>
  </HeroStill>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: var(--space-6);
    max-width: 38rem;
    padding: calc(var(--space-24) + var(--space-8)) var(--gutter) var(--space-16);
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-optic);
  }

  .hero__title {
    font-family: var(--font-mono);
    font-size: var(--text-hero);
    font-weight: 600;
    line-height: 0.86;
    max-width: 100%;
    letter-spacing: var(--tracking-hero);
    text-transform: uppercase;
    text-shadow: 0 1px 24px color-mix(in oklab, var(--color-hero-bg) 70%, transparent);
  }

  .hero__cta a {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    border: var(--rule-width) solid var(--color-accent);
    border-radius: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-hero-fg);
    transition:
      background var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .hero__cta a:hover {
    background: var(--color-accent);
    color: var(--color-accent-fg);
  }

  .hero__rail {
    position: absolute;
    top: 50%;
    right: var(--gutter);
    translate: 0 -50%;
    color: var(--color-hero-muted);
  }

  .hero__notes {
    display: flex;
    position: absolute;
    inset-inline: var(--gutter);
    bottom: var(--space-6);
    justify-content: space-between;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-hero-muted);
  }

  .latest__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
    border-bottom: var(--rule-width) solid var(--color-rule);
  }

  .latest__all {
    text-decoration: none;
  }

  .latest__all:hover {
    color: var(--color-accent);
  }

  .latest__list :global(.post-card:last-child) {
    border-bottom: none;
  }

  .band__label {
    margin-top: auto;
    padding: var(--space-6) var(--gutter);
    color: var(--color-hero-muted);
  }

  @media (max-width: 55rem) {
    .hero__rail,
    .hero__notes-mid {
      display: none;
    }
  }

  @media (max-width: 34rem) {
    .hero__notes {
      display: none;
    }

    .hero {
      padding-bottom: var(--space-12);
    }
  }
</style>
