---
import "../styles/prose.css";

import PageHeader from "../components/PageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { AUTHOR, SITE, SOCIAL } from "../config";

const colophon = [
  { term: "Site", value: "rustboy.ai — making-of" },
  { term: "Framework", value: "Astro 7, static output" },
  { term: "Host", value: "Cloudflare Workers" },
  { term: "Look", value: "Scrap-steel, rust, one green optic" },
  { term: "Type", value: "Source Serif 4 · JetBrains Mono" },
  { term: "Licence", value: "MIT" },
];
---

<BaseLayout title="About" description={AUTHOR.bio}>
  <div class="wrap">
    <PageHeader eyebrow="Colophon" title="About" lede={AUTHOR.bio} />

    <div class="about">
      <div class="prose about__body">
        <p>
          {SITE.title} is a small site on purpose: a home page and a making-of
          notebook. The cupboard is the record. Not a feed.
        </p>

        <p>
          The look is industrial scrap: millboard, rust, one warm green optic
          and an empty socket. Stills and clips live on{" "}
          <a href="https://media.rustboy.ai/">media.rustboy.ai</a>. One serif
          for reading, one monospace for stamps.
        </p>

        <h2>Writing here</h2>

        <p>
          Site metadata lives in <code>src/config.ts</code>. Posts are Markdown
          or MDX files under <code>src/content/blog/</code>, validated against a
          schema so a missing date fails the build rather than the page.
        </p>

        <p>
          Images and videos are not stored in this repository. Upload them to
          the <code>rustboy-media</code> R2 bucket with wrangler and link the
          public URL. The README has the exact commands.
        </p>

        <h2>Elsewhere</h2>

        <ul>
          {
            SOCIAL.map((link) => (
              <li>
                <a href={link.href} rel="noopener">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="about__aside">
        <p class="tategaki about__rail" aria-hidden="true">
          ONE FACE — THE RECORD
        </p>

        <dl class="about__colophon">
          {
            colophon.map((row) => (
              <div class="about__row">
                <dt class="label">{row.term}</dt>
                <dd>{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, var(--width-prose)) 13rem;
    gap: clamp(var(--space-8), 6vw, var(--space-16));
    justify-content: center;
    align-items: start;
    padding-block: var(--space-12);
  }

  .about__aside {
    display: flex;
    gap: var(--space-6);
  }

  .about__rail {
    height: 12rem;
  }

  .about__colophon {
    flex: 1;
    margin: 0;
  }

  .about__row + .about__row {
    margin-top: var(--space-6);
  }

  .about__row dd {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-fg-muted);
  }

  @media (max-width: 60rem) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }

    .about__aside {
      padding-top: var(--space-8);
      border-top: var(--rule-width) solid var(--color-rule);
    }

    .about__rail {
      display: none;
    }
  }
</style>
