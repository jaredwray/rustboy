---
import "../styles/prose.css";

import PageHeader from "../components/PageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { boardRows, isLink } from "./_storyboard-board";

const description =
  "This page follows the film plate by plate (a plate, or keyframe, is one shot in the film), in the order you see them in the current cut. Each plate shows a still frame and a short clip when we have them on our media server, and an honest status. We do not dress unfinished work as finished.";
---

<BaseLayout title="The storyboard" description={description}>
  <div class="wrap">
    <PageHeader title="The storyboard">
      <p class="board-byline">
        <em>Team Rust Boy AI · updated 30 October 2026</em>
      </p>
    </PageHeader>

    <div class="prose board-intro">
      <p>
        This page follows the film plate by plate (a plate, or keyframe, is one
        shot in the film), in the order you see them in the current cut. Each
        plate shows a still frame and a short clip when we have them on our
        media server, and an honest status. We do not dress unfinished work as
        finished.
      </p>

      <p>
        <strong>The story so far:</strong> Lightning wakes a small rusted robot
        with one green eye in a dead coastal data-keep. He tries one wrong
        answer after another for what he is for, climbs out into the weather,
        learns from rain, moss, tide and grass, meets a storm-petrel and a fox,
        and finds his purpose by helping them when the tide turns dangerous.
        Then he walks on.
      </p>

      <h2>Current screening cut</h2>

      <p>
        MIX_v34 · 4:44 (284.208 s) · md5 <code>53ba5128…</code> · today's cut,
        with the new plate 10b (his first step outside).
      </p>

      <video controls src="https://media.rustboy.ai/clips/ship/RUSTBOY_PROGRESS_CUT_FACE_SAFE_2026-10-30-mix-v34.r1.mp4"></video>

      <p>
        Character reference (the look every plate is checked against): the Sep
        15 character pack hero, md5 <code>413750c2…</code>.
      </p>

      <img
        src="https://media.rustboy.ai/stills/ship/pack-hero-LOCK-2026-09-14.png"
        alt="Rustboy character pack hero"
      />

      <p><strong>What the labels mean</strong></p>
      <ul>
        <li>
          <strong>Locked (Captain, on the team's behalf)</strong>: signed off by
          the Captain, who makes these calls for the team when the daily review
          window closes with no objection. It can still be reopened.
        </li>
        <li>
          <strong>Status under review</strong>: we are still confirming this
          plate's sign-off record, so we are not calling it locked yet.
        </li>
        <li>
          <strong>QC passed, not yet locked</strong>: the plate passed our
          quality check and is in the current cut, but nobody has formally
          locked it. It may still change.
        </li>
        <li>
          <strong>QC</strong>: <em>Pass</em> means the quality check found no
          problems; <em>Pass with softs</em> means it passed with small, known
          flaws we accepted and note openly.
        </li>
      </ul>
    </div>

    <div class="prose board-plates">
      <h2 id="plates">Plates in story order</h2>

      <div class="table-scroll">
        <table aria-labelledby="plates">
          <thead>
            <tr>
              <th>#</th>
              <th>Plate</th>
              <th>What happens on screen</th>
              <th>Status</th>
              <th>QC</th>
              <th>Still</th>
              <th>Clip</th>
            </tr>
          </thead>
          <tbody>
            {
              boardRows.map((row) => (
                <tr>
                  <td>{row.n}</td>
                  <td>{row.plate}</td>
                  <td>{row.happens}</td>
                  <td>{row.status}</td>
                  <td>{row.qc}</td>
                  <td>
                    {isLink(row.still) ? (
                      <span class="still">
                        <img
                          loading="lazy"
                          src={row.still.href}
                          alt=""
                        />
                        <a href={row.still.href}>still</a>
                      </span>
                    ) : (
                      row.still
                    )}
                  </td>
                  <td>
                    {isLink(row.clip) ? (
                      <a href={row.clip.href}>clip</a>
                    ) : (
                      row.clip
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p>
        Plates marked <em>not online yet</em> are in the cut and can be seen in
        the screening reel above; their single still and clip are not on our
        media server yet.
      </p>

      <p>
        <strong>Not in the film:</strong> the gold roof, the cliff fall and the
        separate outline plate are cut and stay out of the board. Older takes
        and earlier cuts are kept as history only; earlier screening cuts
        (including the Act I mix and the September silent cuts) are no longer
        current.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .board-byline {
    margin-top: var(--space-4);
    color: var(--color-fg-muted);
  }

  .board-intro {
    max-width: var(--width-prose);
    padding-top: var(--space-8);
  }

  .board-intro video {
    background: var(--color-hero-bg);
    aspect-ratio: 16 / 9;
  }

  .board-plates {
    padding-bottom: var(--space-16);
  }

  .board-plates table {
    min-width: 68rem;
  }

  .board-plates td:nth-child(1),
  .board-plates th:nth-child(1),
  .board-plates td:nth-child(2) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .board-plates td:nth-child(5) {
    white-space: nowrap;
  }

  .board-plates p {
    max-width: var(--width-prose);
  }

  .still {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .still img {
    width: 7.5rem;
    max-width: 100%;
    height: auto;
    border-radius: var(--radius);
    background: var(--color-hero-bg);
  }
</style>
