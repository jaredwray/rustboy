---
import PageHeader from "../components/PageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { AUTHOR } from "../config";
import {
  STORYBOARD_CELLS,
  STORYBOARD_CHROME,
  STORYBOARD_CONTINUITY,
  STORYBOARD_EMPTY_SLOT,
  STORYBOARD_STATUS_GLOSS,
  STORYBOARD_STATUS_LABEL,
} from "../data/storyboard-cells";

const description =
  "Sequential storyboard cells for the rustboy.ai short. We fill each cell as the plate is finished — still and clip when we have them.";

const cellId = (n: number) => `cell-${String(n).padStart(2, "0")}`;
const cellIndex = (n: number) => String(n).padStart(2, "0");
---

<BaseLayout title="Storyboard" description={description}>
  <div class="wrap">
    <PageHeader
      eyebrow="Film"
      title="Storyboard"
      lede="We fill each cell as the plate is finished — still and clip when we have them."
    />

    <p class="storyboard__byline">
      <em>{AUTHOR.name} · film page · 15 September 2026</em>
    </p>

    <p class="storyboard__gloss">{STORYBOARD_STATUS_GLOSS}</p>

    <section class="chrome" aria-label="Screening cuts">
      <figure class="chrome__block">
        <figcaption class="label">FACE_SAFE progress cut</figcaption>
        <div class="chrome__media">
          <img
            src={STORYBOARD_CHROME.progressCut.stillUrl}
            alt="FACE_SAFE progress-cut contact still"
            width="1280"
            height="720"
            loading="eager"
            decoding="async"
          />
          <video
            controls
            preload="none"
            playsinline
            width="1920"
            height="1080"
            poster={STORYBOARD_CHROME.progressCut.stillUrl}
            src={STORYBOARD_CHROME.progressCut.clipUrl}
          ></video>
        </div>
      </figure>

      <figure class="chrome__block">
        <figcaption class="label">Act I reel</figcaption>
        <video
          controls
          preload="none"
          playsinline
          width="1920"
          height="1080"
          src={STORYBOARD_CHROME.actIReel.clipUrl}
        ></video>
      </figure>
    </section>

    <div class="board-scroll">
      <table class="board">
        <caption class="visually-hidden">
          Sequential storyboard cells. Each row is a plate with still, clip,
          title, and status.
        </caption>
        <thead>
          <tr>
            <th scope="col">Cell</th>
            <th scope="col">Plate</th>
            <th scope="col">Clip</th>
            <th scope="col">Story</th>
          </tr>
        </thead>
        <tbody>
          {
            STORYBOARD_CELLS.map((cell) => (
              <tr id={cellId(cell.n)}>
                <th scope="row" class="board__index">
                  <span class="board__n">{cellIndex(cell.n)}</span>
                </th>
                <td class="board__media">
                  {cell.stillUrl ? (
                    <img
                      src={cell.stillUrl}
                      alt={`Cell ${cellIndex(cell.n)} plate — ${cell.title}`}
                      width="1920"
                      height="1080"
                      loading={cell.n <= 2 ? "eager" : "lazy"}
                      decoding="async"
                    />
                  ) : (
                    <p class="board__empty">{STORYBOARD_EMPTY_SLOT}</p>
                  )}
                </td>
                <td class="board__media">
                  {cell.clipUrl ? (
                    <video
                      controls
                      preload="none"
                      playsinline
                      width="1920"
                      height="1080"
                      poster={cell.stillUrl}
                      src={cell.clipUrl}
                    >
                      {`Cell ${cellIndex(cell.n)} clip — ${cell.title}`}
                    </video>
                  ) : (
                    <p class="board__empty">{STORYBOARD_EMPTY_SLOT}</p>
                  )}
                </td>
                <td class="board__story">
                  <div class="board__meta">
                    <h2 class="board__title">{cell.title}</h2>
                    <p
                      class:list={[
                        "board__status",
                        `board__status--${cell.status}`,
                      ]}
                    >
                      {STORYBOARD_STATUS_LABEL[cell.status]}
                    </p>
                  </div>
                  <p class="board__blurb">{cell.blurb}</p>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="storyboard__continuity">{STORYBOARD_CONTINUITY}</p>
    <p class="storyboard__signoff">— {AUTHOR.name}</p>
  </div>
</BaseLayout>

<style>
  .storyboard__byline {
    margin-top: var(--space-8);
    color: var(--color-fg-muted);
  }

  .storyboard__gloss {
    margin-top: var(--space-4);
    max-width: var(--width-prose);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-fg-muted);
  }

  .chrome {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-8);
    margin-top: var(--space-12);
    padding-bottom: var(--space-12);
    border-bottom: var(--rule-width) solid var(--color-rule);
  }

  .chrome__block {
    margin: 0;
  }

  .chrome__block figcaption {
    margin-bottom: var(--space-3);
  }

  .chrome__media {
    display: grid;
    gap: var(--space-3);
  }

  .chrome img,
  .chrome video {
    width: 100%;
    border-radius: var(--radius);
    background: var(--color-bg-subtle);
  }

  .board-scroll {
    margin-top: var(--space-12);
    overflow-x: auto;
  }

  .board {
    width: 100%;
    border-collapse: collapse;
  }

  .board th,
  .board td {
    vertical-align: top;
    text-align: left;
    padding: var(--space-6) var(--space-4);
    border-bottom: var(--rule-width) solid var(--color-rule);
  }

  .board thead th {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-fg-faint);
    border-bottom-color: var(--color-rule-strong);
    padding-block: var(--space-3);
  }

  .board__index {
    width: 3.5rem;
    padding-inline: 0 var(--space-3);
    font-weight: 400;
  }

  .board__n {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    color: var(--color-fg-faint);
  }

  .board__media {
    width: 28%;
    min-width: 12rem;
  }

  .board__media img,
  .board__media video {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--color-hero-bg);
    border-radius: var(--radius);
  }

  .board__empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 8rem;
    aspect-ratio: 16 / 9;
    padding: var(--space-4);
    background: var(--color-bg-subtle);
    border: var(--rule-width) dashed var(--color-rule-strong);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-fg-faint);
  }

  .board__story {
    min-width: 14rem;
  }

  .board__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3) var(--space-4);
  }

  .board__title {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .board__status {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-fg-faint);
  }

  .board__status--finished {
    color: var(--color-optic);
  }

  .board__status--parked {
    color: var(--color-accent);
  }

  .board__blurb {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-fg-muted);
  }

  .storyboard__continuity {
    margin-top: var(--space-12);
    max-width: 42rem;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-fg-muted);
  }

  .storyboard__signoff {
    margin-top: var(--space-6);
    margin-bottom: var(--space-12);
    color: var(--color-fg-muted);
  }

  @media (max-width: 52rem) {
    .chrome {
      grid-template-columns: 1fr;
    }

    .board,
    .board thead,
    .board tbody,
    .board tr,
    .board th,
    .board td {
      display: block;
      width: 100%;
    }

    .board thead {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }

    .board tr {
      padding: var(--space-8) 0;
      border-bottom: var(--rule-width) solid var(--color-rule);
    }

    .board th,
    .board td {
      padding: 0;
      border: 0;
    }

    .board__index {
      margin-bottom: var(--space-3);
    }

    .board__media + .board__media,
    .board__story {
      margin-top: var(--space-3);
    }

    .board__media {
      min-width: 0;
    }
  }
</style>
