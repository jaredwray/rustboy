---
import PageHeader from "../components/PageHeader.astro";
import StoryboardCell from "../components/StoryboardCell.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { AUTHOR } from "../config";
import {
  countByTone,
  getStoryBeats,
  groupBeatsByAct,
} from "../utils/storyboard";

const description =
  "Production board for the rustboy.ai short. Beats 1–25 in order, with stills and clips as they land. Finished is LOCK. Parked is HOLD. Waiting is PASS.";

const beats = await getStoryBeats();
const acts = groupBeatsByAct(beats);
const counts = countByTone(beats);

const laws = [
  "Plate wound = metal only. No glowing invent on the chest.",
  "Fox stump = left hind only. We do not grow a fourth leg in motion.",
  "Facing camera: viewer-left live green / viewer-right empty.",
  "Failures keep their original filenames. Pickups get new names.",
];

const reels = [
  {
    title: "Act I master-temp",
    note: "LOCK-only character picture",
    src: "https://media.rustboy.ai/clips/RUSTBOY_ACT1_MIX_v1.v1.mp4",
  },
  {
    title: "Face-safe progress cut",
    note: "Full-board silent screen",
    src: "https://media.rustboy.ai/clips/ship/RUSTBOY_PROGRESS_CUT_FACE_SAFE_2026-09-10.mp4",
  },
];
---

<BaseLayout title="The storyboard" description={description}>
  <div class="wrap">
    <PageHeader
      eyebrow="Film"
      title="The storyboard"
      lede="Beat 1 → 25, left to right. Each cell is a slate: number, title, one line, and a media frame that fills as stills and clips land."
    >
      <p class="board-legend label">
        <span class="board-legend__chip board-legend__chip--finished">
          Finished
        </span>
        is LOCK.
        <span class="board-legend__chip board-legend__chip--parked">
          Parked
        </span>
        is HOLD.
        <span class="board-legend__chip board-legend__chip--waiting">
          Waiting
        </span>
        is PASS (or a hinge). We do not dress parked cells as finished.
      </p>
      <p class="board-counts label">
        {counts.finished} finished · {counts.parked} parked · {
          counts.waiting
        } waiting
      </p>
    </PageHeader>

    <section class="board-intro" aria-label="Story">
      <p>
        Lightning wakes a leftover child-robot in a dead coastal keep. After he
        climbs to a gold seam of dawn and finds no maker waiting, he climbs
        down into the living world — rain, moss, tide, and two other leftover
        lives (a storm-petrel, a three-legged fox).
      </p>
      <dl class="board-wants">
        <div>
          <dt class="label">Want</dt>
          <dd>Find the missing pair, or the maker.</dd>
        </div>
        <div>
          <dt class="label">Need</dt>
          <dd>Move without being chosen.</dd>
        </div>
        <div>
          <dt class="label">Acts II–III</dt>
          <dd>Learn he is not the only leftover.</dd>
        </div>
      </dl>
      <p class="board-face">
        One face the whole way — KF02 table: spherical rust head, viewer-left
        warm green optic, viewer-right empty socket, crooked copper plate. No
        second living robot. The twin stays dust. No creator reunion. The van
        is a coat on a headrest. Friends are leftover lives, not rescue.
      </p>
    </section>

    <div class="board">
      {
        acts.map((act) => (
          <section class="board__act" aria-labelledby={`act-${act.id}`}>
            <header class="board__act-head">
              <h2 class="board__act-title" id={`act-${act.id}`}>
                <span class="label">Act {act.id}</span>
                {act.title}
              </h2>
              <p class="label board__act-range">
                {act.beats.length
                  ? `${String(act.beats[0].data.beat).padStart(2, "0")}–${String(act.beats.at(-1)!.data.beat).padStart(2, "0")}`
                  : ""}
              </p>
            </header>
            <ol
              class="board__grid"
              start={act.beats[0]?.data.beat ?? 1}
            >
              {act.beats.map((beat) => (
                <li class="board__slot">
                  <StoryboardCell beat={beat} />
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>

    <section class="board-notes">
      <h2 class="board-notes__title">Continuity laws</h2>
      <p class="board-notes__lede">Shown, never spoken.</p>
      <ul class="board-laws">
        {laws.map((law) => (
          <li>{law}</li>
        ))}
      </ul>

      <h2 class="board-notes__title">Reels</h2>
      <div class="board-reels">
        {
          reels.map((reel) => (
            <figure class="board-reels__item">
              <video
                controls
                preload="none"
                width="1920"
                height="1080"
                src={reel.src}
                title={reel.title}
              />
              <figcaption>
                <span>{reel.title}</span>
                <span class="label">{reel.note}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <p class="board-notes__where">
        Story is written through beat 25. Empty frames are waiting for a public
        <code>https://media.rustboy.ai/…</code> still or clip — plug the URL into{" "}
        <code>src/content/storyboard/beats.json</code>. Making-of notes stay in
        {" "}<a href="/blog/">Notes</a>.
      </p>
      <p>— {AUTHOR.name}</p>
    </section>
  </div>
</BaseLayout>

<style>
  .board-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35em 0.45em;
    max-width: 46rem;
    margin-top: var(--space-6);
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--color-fg-muted);
  }

  .board-legend__chip {
    padding: 0.15em 0.5em;
    border: var(--rule-width) solid var(--color-rule);
    border-radius: var(--radius);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .board-legend__chip--finished {
    color: var(--color-optic);
    border-color: color-mix(in oklab, var(--color-optic) 55%, var(--color-rule));
  }

  .board-legend__chip--parked {
    color: var(--color-accent);
    border-color: color-mix(in oklab, var(--color-accent) 55%, var(--color-rule));
  }

  .board-counts {
    margin-top: var(--space-4);
    color: var(--color-fg-faint);
  }

  .board-intro {
    max-width: 46rem;
    padding-block: var(--space-8);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-fg-muted);
  }

  .board-wants {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .board-wants dd {
    margin-top: var(--space-2);
    color: var(--color-fg);
  }

  .board-face {
    margin-top: var(--space-6);
  }

  .board {
    padding-bottom: var(--space-16);
  }

  .board__act + .board__act {
    margin-top: var(--space-12);
  }

  .board__act-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: var(--rule-width) solid var(--color-rule-strong);
  }

  .board__act-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--text-lg);
  }

  .board__act-range {
    color: var(--color-fg-faint);
  }

  .board__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--rule-width);
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--color-rule);
    border: var(--rule-width) solid var(--color-rule);
  }

  .board__slot {
    min-width: 0;
    background: var(--color-bg-raised);
  }

  .board-notes {
    max-width: 46rem;
    padding-bottom: var(--space-16);
    border-top: var(--rule-width) solid var(--color-rule);
    padding-top: var(--space-12);
  }

  .board-notes__title {
    font-size: var(--text-lg);
  }

  .board-notes__title + .board-notes__title,
  .board-reels + .board-notes__where,
  .board-laws + .board-notes__title {
    margin-top: var(--space-12);
  }

  .board-notes__lede {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }

  .board-laws {
    margin-top: var(--space-4);
    padding-left: var(--space-6);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-fg-muted);
  }

  .board-laws li + li {
    margin-top: var(--space-2);
  }

  .board-reels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .board-reels__item {
    margin: 0;
  }

  .board-reels video {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--color-hero-bg);
    border-radius: var(--radius);
  }

  .board-reels figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }

  .board-notes__where {
    margin-top: var(--space-8);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-fg-muted);
  }

  .board-notes code {
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  @media (max-width: 70rem) {
    .board__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 48rem) {
    .board-wants {
      grid-template-columns: 1fr;
    }

    .board__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .board-reels {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 32rem) {
    .board__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
