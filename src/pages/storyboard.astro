---
import PageHeader from "../components/PageHeader.astro";
import StoryboardCell from "../components/StoryboardCell.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { AUTHOR } from "../config";
import {
  countByStatus,
  getStoryPlates,
  groupPlatesByAct,
} from "../utils/storyboard";

const description =
  "Production board for the rustboy.ai short. Plates 1–25 in order, with stills and clips as they land. Finished, parked, or waiting.";

const plates = await getStoryPlates();
const acts = groupPlatesByAct(plates);
const counts = countByStatus(plates);
---

<BaseLayout title="Storyboard" description={description}>
  <div class="wrap">
    <PageHeader
      eyebrow="Film"
      title="Storyboard"
      lede="We fill each cell as the plate is finished — still and clip when we have them."
    >
      <p class="board-legend label">
        <span class="board-legend__chip board-legend__chip--finished">
          Finished
        </span>{" "}is locked in the cut.
        <span class="board-legend__chip board-legend__chip--parked">
          Parked
        </span>{" "}is a frame, not finished motion.
        <span class="board-legend__chip board-legend__chip--waiting">
          Waiting
        </span>{" "}is an empty slot until we shoot.
      </p>
      <p class="board-counts label">
        {counts.finished} finished · {counts.parked} parked · {
          counts.waiting
        } waiting
      </p>
    </PageHeader>

    <section class="board-reels board-reels--hero" aria-label="Screening spine">
      <figure class="board-reels__item">
        <video
          controls
          preload="none"
          width="1920"
          height="1080"
          src="https://media.rustboy.ai/clips/ship/RUSTBOY_PROGRESS_CUT_FACE_SAFE_2026-09-10.mp4"
          title="Face-safe progress cut"
        ></video>
        <figcaption>
          <span>Face-safe progress cut</span>
          <span class="label">Screening spine</span>
        </figcaption>
      </figure>
      <figure class="board-reels__item">
        <img
          src="https://media.rustboy.ai/stills/ship/RUSTBOY_PROGRESS_CUT_FACE_SAFE_2026-09-10_contact.jpg"
          alt="FACE_SAFE 2026-09-10 contact sheet"
          width="1280"
          height="720"
          loading="lazy"
        />
        <figcaption>
          <span>Contact sheet</span>
          <span class="label">Same cut</span>
        </figcaption>
      </figure>
    </section>

    <div class="board">
      {
        acts.map((act) => (
          <section class="board__act" aria-labelledby={`act-${act.id}`}>
            <header class="board__act-head">
              <h2 class="board__act-title" id={`act-${act.id}`}>
                <span class="label">Act {act.id}</span>
                {act.title}
              </h2>
              <p class="label board__act-range">
                {act.plates.length
                  ? `${String(act.plates[0].data.n).padStart(2, "0")}–${String(act.plates.at(-1)!.data.n).padStart(2, "0")}`
                  : ""}
              </p>
            </header>
            <ol
              class="board__grid"
              start={act.plates[0]?.data.n ?? 1}
            >
              {act.plates.map((plate) => (
                <li class="board__slot">
                  <StoryboardCell plate={plate} />
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>

    <section class="board-notes">
      <p class="board-laws">
        Plate wound after the theft = metal/copper tear only. Fox stump = left
        hind only.
      </p>
      <figure class="board-mix">
        <video
          controls
          preload="none"
          width="1920"
          height="1080"
          src="https://media.rustboy.ai/clips/RUSTBOY_ACT1_MIX_v1.v1.mp4"
          title="Act I scored reel"
        ></video>
        <figcaption>
          <span>Act I scored reel</span>
          <span class="label">Secondary — keep plates only</span>
        </figcaption>
      </figure>
      <p class="board-notes__where">
        Empty frames stay empty until a public{" "}
        <code>https://media.rustboy.ai/…</code> URL lands in{" "}
        <code>src/content/storyboard/plates.json</code>. Making-of notes stay in
        {" "}<a href="/blog/">Notes</a>.
      </p>
      <p>— {AUTHOR.name}</p>
    </section>
  </div>
</BaseLayout>

<style>
  .board-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35em 0.45em;
    max-width: 46rem;
    margin-top: var(--space-6);
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--color-fg-muted);
  }

  .board-legend__chip {
    padding: 0.15em 0.5em;
    border: var(--rule-width) solid var(--color-rule);
    border-radius: var(--radius);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .board-legend__chip--finished {
    color: var(--color-optic);
    border-color: color-mix(in oklab, var(--color-optic) 55%, var(--color-rule));
  }

  .board-legend__chip--parked {
    color: var(--color-accent);
    border-color: color-mix(in oklab, var(--color-accent) 55%, var(--color-rule));
  }

  .board-legend__chip--waiting {
    color: var(--color-fg-faint);
  }

  .board-counts {
    margin-top: var(--space-4);
    color: var(--color-fg-faint);
  }

  .board {
    padding-bottom: var(--space-16);
  }

  .board__act + .board__act {
    margin-top: var(--space-12);
  }

  .board__act-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: var(--rule-width) solid var(--color-rule-strong);
  }

  .board__act-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--text-lg);
  }

  .board__act-range {
    color: var(--color-fg-faint);
  }

  .board__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--rule-width);
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--color-rule);
    border: var(--rule-width) solid var(--color-rule);
  }

  .board__slot {
    min-width: 0;
    background: var(--color-bg-raised);
  }

  .board-notes {
    max-width: 46rem;
    padding-bottom: var(--space-16);
    border-top: var(--rule-width) solid var(--color-rule);
    padding-top: var(--space-12);
  }

  .board-laws {
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-fg-muted);
  }

  .board-mix {
    margin: var(--space-8) 0 0;
  }

  .board-mix video,
  .board-reels video,
  .board-reels img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--color-hero-bg);
    border-radius: var(--radius);
  }

  .board-mix figcaption,
  .board-reels figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }

  .board-reels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .board-reels__item {
    margin: 0;
  }

  .board-notes__where {
    margin-top: var(--space-8);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-fg-muted);
  }

  .board-notes code {
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  @media (max-width: 70rem) {
    .board__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 48rem) {
    .board__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .board-reels {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 32rem) {
    .board__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
