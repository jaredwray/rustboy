---
import { NAV, SITE } from "../config";
import FaceMark from "./FaceMark.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  /** Lay the header over the hero instead of pushing it down. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const isCurrent = (href: string) =>
  path === href || (href !== "/" && path.startsWith(`${href}/`));
---

<header class="site-header" data-overlay={overlay ? "" : undefined}>
  <a class="brand" href="/">
    <FaceMark />
    <span class="brand__mark">{SITE.title}</span>
    {
      SITE.titleMark && (
        <span class="brand__sub">{SITE.titleMark}</span>
      )
    }
  </a>

  <div class="site-header__end">
    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: 100%;
    padding: var(--space-6) var(--gutter);
    overflow-x: clip;
  }

  .site-header[data-overlay] {
    position: absolute;
    inset-inline: 0;
    top: 0;
    color: var(--color-hero-fg);
  }

  .site-header[data-overlay] .nav a,
  .site-header[data-overlay] .brand__sub,
  .site-header[data-overlay] .theme-toggle {
    color: var(--color-hero-muted);
  }

  .site-header[data-overlay] .nav a:hover,
  .site-header[data-overlay] .nav a[aria-current="page"],
  .site-header[data-overlay] .theme-toggle:hover {
    color: var(--color-hero-fg);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
  }

  .brand :global(.face-mark) {
    font-size: 1.15rem;
  }

  .brand:hover {
    color: inherit;
  }

  .brand__mark {
    font-family: var(--font-mono);
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .brand__sub {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-fg-faint);
  }

  .site-header__end {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-4), 3vw, var(--space-8));
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-4), 3vw, var(--space-8));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-fg-muted);
  }

  .nav a:hover,
  .nav a[aria-current="page"] {
    color: var(--color-fg);
  }

  .nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4em;
  }

  @media (max-width: 48rem) {
    .brand__sub {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .site-header {
      gap: var(--space-3);
      padding-block: var(--space-4);
    }

    .site-header__end,
    .nav__list {
      gap: var(--space-3);
    }
  }

  /* Four nav labels plus brand overflow common 360–390px phones.
     overflow-x: clip would hide the rightmost controls, so wrap here. */
  @media (max-width: 28rem) {
    .brand :global(.face-mark) {
      display: none;
    }

    .site-header {
      flex-wrap: wrap;
    }

    .site-header,
    .site-header__end,
    .nav__list {
      gap: var(--space-2);
    }
  }
</style>
